# Root ignore
.DS_Store
Thumbs.db
*.log
.env
.env.backup
.env.production
.idea/
.vscode/

# Backend (Laravel)
backend/vendor/
backend/node_modules/
backend/public/storage/
backend/storage/*.key
backend/storage/app/tenants/
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*
backend/.env
backend/.phpunit.result.cache

# Frontend (Next.js)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env*.local
